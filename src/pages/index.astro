---
import Base from '../layouts/Base.astro';
import Pager from '../components/Pager.astro';
import { getAllPosts } from '../lib/posts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (f: string) => `${base}/img/${f}`;

const keys = [
  { label: 'Kernel',    href: `${base}/kernel/` },
  { label: 'CVE',       href: `${base}/cve/` },
  { label: 'Reversing', href: `${base}/reversing/` },
  { label: 'Tooling',   href: `${base}/tooling/` },
  { label: 'Notes',     href: `${base}/notes/` },
];

const posts = await getAllPosts();
const featured = posts.filter((p) => p.featured).slice(0, 3);
const latest = posts;
const searchData = posts.map((p) => ({ t: p.title, h: p.href, c: p.category }));
const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---
<Base title="Subtitle Log — Security Research Notebook" bodyClass="desk">
  <section class="hero" id="top">
    <div class="valance" aria-hidden="true"></div>
    <img class="curtain-img left" src={img('curtain_left.png')} alt="" aria-hidden="true" />
    <img class="curtain-img right" src={img('curtain_right.png')} alt="" aria-hidden="true" />

    <div class="sign">
      <h1>Subtitle Log</h1>
      <div class="role">Security Research Notebook</div>
    </div>

    <div class="searchwrap">
      <div class="searchbox">
        <svg class="search-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
        <input id="siteSearch" class="search-input" type="text" placeholder="Search…" autocomplete="off" aria-label="Search posts" />
      </div>
      <div class="search-results" id="searchResults"></div>
    </div>

    <nav class="rack" id="categories" aria-label="Categories">
      {keys.map((k) => (
        <a class="peg" href={k.href} aria-label={k.label}>
          <span class="plate">
            <img src={img('plate.png')} alt="" aria-hidden="true" />
            <span class="plabel">{k.label}</span>
          </span>
          <img class="keyimg" src={img('key.png')} alt="" aria-hidden="true" />
        </a>
      ))}
    </nav>

    <div class="scrollcue mono"><span>Scroll</span><span class="chev"></span></div>
  </section>

  <script is:inline>
    requestAnimationFrame(() => requestAnimationFrame(() => {
      document.documentElement.classList.add('anim-ready');
    }));
  </script>

  <section class="console">
    <div class="console-inner">
      <div class="console-top">
        <img class="lamp" src={img('lamp.png')} alt="" aria-hidden="true" />
        <img class="vase" src={img('vase.png')} alt="" aria-hidden="true" />
        <img class="lamp" src={img('lamp.png')} alt="" aria-hidden="true" />
      </div>
      <div class="cabinet">
        <div class="ledger-frame" id="featured">
          <div class="sect-head"><span class="placard">Featured Posts</span></div>
          <div class="plist">
            {featured.length === 0 && <div class="empty">No featured posts yet.</div>}
            {featured.map((p) => (
              <a href={p.href}>
                <span class="phead"><span class="pt">{p.title}</span><span class="pd">{fmt(p.date)}</span></span>
                <span class="ps">{p.summary}</span>
                <span class="ptags"><span class="tag">{p.category}</span></span>
              </a>
            ))}
          </div>
        </div>
        <div class="latest-wrap" id="latestWrap">
          <div class="sect-head"><span class="placard">Latest Entries</span></div>
          <div class="plist" id="latestList">
            {latest.length === 0 && <div class="empty">No posts yet.</div>}
            {latest.map((p, i) => (
              <a class="lrow" href={p.href} data-idx={i}>
                <span class="phead"><span class="pt">{p.title}</span><span class="pd">{fmt(p.date)}</span></span>
                <span class="ps">{p.summary}</span>
                <span class="ptags"><span class="tag">{p.category}</span></span>
              </a>
            ))}
          </div>
          <Pager listId="latestList" rowSel=".lrow" per={5} />
        </div>
      </div>
    </div>
  </section>

  <footer class="home-foot" id="connect">
    <div class="connect-label">Connect</div>
    <a href="mailto:subtitle8080@gmail.com">subtitle8080@gmail.com</a>
  </footer>

  <script define:vars={{ searchData }}>
    (function () {
      var data = searchData || [];
      var input = document.getElementById('siteSearch');
      var box = document.getElementById('searchResults');
      if (!input || !box) return;
      function render(q) {
        box.innerHTML = '';
        q = (q || '').trim().toLowerCase();
        if (!q) { box.classList.remove('open'); return; }
        var hits = data.filter(function (p) {
          return p.t.toLowerCase().indexOf(q) > -1 || (p.c && p.c.toLowerCase().indexOf(q) > -1);
        }).slice(0, 7);
        if (!hits.length) { box.innerHTML = '<div class="sr-empty">No results</div>'; box.classList.add('open'); return; }
        hits.forEach(function (p) {
          var a = document.createElement('a');
          a.href = p.h; a.className = 'sr-item';
          var t = document.createElement('span'); t.className = 'sr-t'; t.textContent = p.t;
          var c = document.createElement('span'); c.className = 'sr-c'; c.textContent = p.c;
          a.appendChild(t); a.appendChild(c); box.appendChild(a);
        });
        box.classList.add('open');
      }
      input.addEventListener('input', function () { render(input.value); });
      input.addEventListener('focus', function () { if (input.value) render(input.value); });
      document.addEventListener('click', function (e) { if (!e.target.closest('.searchwrap')) box.classList.remove('open'); });
    })();
  </script>
</Base>
