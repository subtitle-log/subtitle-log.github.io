---
import Base from './Base.astro';
export interface Props {
  title: string;
  description?: string;
  label?: string;
  lead?: string;
  center?: boolean;
  flora?: boolean;
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { title, description, label, lead, center = false, flora = false } = Astro.props;
const img = (f: string) => `${base}/img/${f}`;
---
<Base title={`${title} — Subtitle Log`} description={description} bodyClass="inner">
  <header class="inner-top">
    <div class="in">
      <a class="back" href={base + '/'} aria-label="Back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg></a>
    </div>
  </header>

  <main class="inner-body">
    <div class={`page-head${center ? ' center' : ''}`}>
      {center && <img class="head-divider" src={img('divider.png')} alt="" aria-hidden="true" />}
      {label && <div class="plabel">{label}</div>}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
    </div>
    <slot />
  </main>
</Base>
